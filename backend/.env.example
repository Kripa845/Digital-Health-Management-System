# ---------------------------------------------------------------------------
# Mero Care Card — Backend environment variables
# Copy to `backend/.env` for local development, or set these in your host's
# dashboard for production. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Core Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated allowed hosts. Required when DEBUG=False (e.g. api.example.com).
# Leave empty in local dev to allow localhost only.
ALLOWED_HOSTS=

# Database — leave unset to use local SQLite. In production set the Postgres URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# CORS — comma-separated frontend origins allowed to call the API.
# Required when DEBUG=False. Leave empty in local dev (all origins allowed, no credentials).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend origin — base URL of the React SPA. Used for QR-code targets and the
# login link in welcome emails.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Cloudinary (optional). If all three are set, uploaded media is stored there.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Optional: auto-seed an ADMIN on migrate (used by some hosts). If set, an
# admin account is ensured at the end of every `migrate`.
# ---------------------------------------------------------------------------
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_EMAIL=admin@merocare.com
# DJANGO_ADMIN_PASSWORD=

# Email configurations
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=merocarecard@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Mero Care Card <merocarecard@gmail.com>

# ---------------------------------------------------------------------------
# Limits (optional)
# ---------------------------------------------------------------------------
# Login attempts per IP (DRF rate format).
# LOGIN_THROTTLE_RATE=10/min
# Lab report OCR runs inside the upload request; these keep it within the timeout.
# OCR_MAX_PDF_PAGES=5
# OCR_PDF_DPI=200
# Gunicorn (Docker image): worker count and request timeout in seconds.
# WEB_CONCURRENCY=3
# GUNICORN_TIMEOUT=120

# ---------------------------------------------------------------------------
# Lab report files are encrypted at rest. Set a dedicated key in production
# (otherwise one is derived from SECRET_KEY). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key makes previously uploaded reports unreadable.
# ---------------------------------------------------------------------------
# LAB_REPORT_ENCRYPTION_KEY=

# Lab report uploads
# LAB_UPLOAD_THROTTLE_RATE=20/hour
# Detect uploaded file types with python-magic. Needs the libmagic system library
# (installed in the Docker image). Leave False on Windows: without libmagic,
# importing python-magic hangs. A built-in file-signature check is used instead.
# LAB_USE_LIBMAGIC=False
# A report dated before the patient's latest confirmed report: warn (default; the
# user must confirm), block (refused) or allow (no warning).
# LAB_REPORT_OLDER_DATE_POLICY=warn
# Numeric dates on reports: DMY (14/09/2026, default) or MDY (09/14/2026).
# LAB_REPORT_DATE_ORDER=DMY

# Optional AI fallback for reports the PDF text and OCR could not read: the page
# images are sent to Anthropic (Claude) to read haemoglobin, cholesterol, blood
# sugar and the patient ID. PATIENT DATA LEAVES THIS SERVER when it is used, so
# it is off unless set to True. Needs an API key from console.anthropic.com.
# LAB_LLM_FALLBACK=False
# ANTHROPIC_API_KEY=
# LAB_LLM_MODEL=claude-opus-5-5
# LAB_LLM_TIMEOUT=45
