# ---------------------------------------------------------------------------
# Mero Care Card — Backend environment variables
# Copy to `backend/.env` for local development, or set these in your host's
# dashboard for production. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Core Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated allowed hosts. Use your API host in production.
ALLOWED_HOSTS=*

# Database — leave unset to use local SQLite. In production set the Postgres URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# CORS — comma-separated frontend origins allowed to call the API.
# Leave empty in local dev (all origins allowed, no credentials).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend origin — base URL of the React SPA. Used to build QR-code targets.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Cloudinary (optional). If all three are set, uploaded media is stored there.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Optional: auto-seed an ADMIN on migrate (used by some hosts). If set, an
# admin account is ensured at the end of every `migrate`.
# ---------------------------------------------------------------------------
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_EMAIL=admin@merocare.com
# DJANGO_ADMIN_PASSWORD=

# Email configurations
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=merocarecard@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Mero Care Card <merocarecard@gmail.com>

