# Frontend environment
# In dev, leave VITE_API_URL empty — Vite proxies /api and /media to http://127.0.0.1:8000.
# In production, set this to your API host origin (no trailing slash), e.g. https://api.merocare.health
VITE_API_URL=

# Public address of this site, printed in patient QR codes (no trailing slash),
# e.g. https://merocarecard.example. If empty, the address the page is opened from is used.
VITE_FRONTEND_URL=
